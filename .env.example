# Copy to apps/api/.env and apps/web/.env.local (see README).

# --- api ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://hub:hub@localhost:5434/learning_hub?schema=public
# Public URL of the web app (OAuth redirects, CORS/Origin checks)
WEB_ORIGIN=http://localhost:3000
# GitHub OAuth app (create one at https://github.com/settings/developers)
# Callback URL (the web app proxies /api to the api): http://localhost:3000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# New accounts become active when a verified GitHub email is on the club's email list
# (admin: PUT /api/v1/admin/approved-emails). Others wait for approval.
# Optional extra rule: members of this GitHub org are approved too (leave empty to turn off)
GITHUB_ORG=
# First admin (GitHub login), granted on first sign-in
BOOTSTRAP_ADMIN_GITHUB_LOGIN=
LOG_LEVEL=info
# Proxy hops before the API (per-IP rate limit). 1 locally; production: deploy/.env.example
TRUST_PROXY_HOPS=1
# Content source (CONTENT-SPECIFICATION §8): `local` reads a folder, `github` reads a repo
# `registry` reads tracks.yaml in CONTENT_REPO, then each track repo at its pinned commit (ADR-10)
CONTENT_SOURCE=local
CONTENT_LOCAL_DIR=../../content-example
CONTENT_REPO=hcmute-dsc/learning-hub-content
CONTENT_BRANCH=main
# Optional, read-only fine-grained token (higher rate limit / private repo)
CONTENT_GITHUB_TOKEN=
# Reference solutions (CONTENT-SPECIFICATION §3.8): `none`, `local` (a folder) or `github` (the
# private checker repo). Members see a solution only once they complete the exercise.
SOLUTIONS_SOURCE=local
SOLUTIONS_LOCAL_DIR=../../checker-example

# --- web ---
# Server-side base URL of the api
API_INTERNAL_URL=http://localhost:4000

# Mentor review target in hours, shown in the review queue (E7)
REVIEW_TARGET_HOURS=72
# Most active mentees per mentor, all tracks together (US-11); set per term
MENTOR_MAX_MENTEES=5
# Leaderboard score per completed exercise (E14): graded/approved vs self_check; set per term
LEADERBOARD_WEIGHT_GRADED=3
LEADERBOARD_WEIGHT_SELF_CHECK=1
# Discord application for "Kết nối Discord" in /settings (learning-hub#76; scope identify).
# Empty = linking off. Keep the secret out of git (deploy/README.md §Discord).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord webhooks (optional; empty = off): club notifications (E9) and server-error alerts (E11)
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_WEBHOOK_URL=
