# Copy to apps/api/.env and apps/web/.env.local (see README).

# --- api ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://hub:hub@localhost:5434/learning_hub?schema=public
# Public URL of the web app (OAuth redirects, CORS/Origin checks)
WEB_ORIGIN=http://localhost:3000
# GitHub OAuth app (create one at https://github.com/settings/developers)
# Callback URL (the web app proxies /api to the api): http://localhost:3000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Members of this GitHub org become active automatically; others wait for approval
GITHUB_ORG=hcmute-dsc
# Comma-separated GitHub logins that are always active (optional)
ALLOWLIST_GITHUB_LOGINS=
# First admin (GitHub login), granted on first sign-in
BOOTSTRAP_ADMIN_GITHUB_LOGIN=
LOG_LEVEL=info
# Content source (CONTENT-SPECIFICATION §8): `local` reads a folder, `github` reads a repo
CONTENT_SOURCE=local
CONTENT_LOCAL_DIR=../../content-example
CONTENT_REPO=hcmute-dsc/learning-hub-content
CONTENT_BRANCH=main
# Optional, read-only fine-grained token (higher rate limit / private repo)
CONTENT_GITHUB_TOKEN=

# --- web ---
# Server-side base URL of the api
API_INTERNAL_URL=http://localhost:4000
