# /etc/nginx/sites-available/learn.hcmute-dsc.io.vn
# Enable: sudo ln -s /etc/nginx/sites-available/learn.hcmute-dsc.io.vn /etc/nginx/sites-enabled/
# HTTPS:  sudo certbot --nginx -d learn.hcmute-dsc.io.vn   (adds the listen 443 part)
# Check and reload: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name learn.hcmute-dsc.io.vn;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The API limits requests per member IP: it needs the real client address.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
