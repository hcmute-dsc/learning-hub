# Traefik file provider (dynamic configuration), e.g. /etc/traefik/dynamic/learning-hub.yml.
# Assumes an entry point "websecure" and a certificate resolver "letsencrypt"; use the
# names from your traefik.yml. If Traefik runs in Docker, replace 127.0.0.1 with
# host.docker.internal (and add extra_hosts "host.docker.internal:host-gateway").

http:
  routers:
    learning-hub:
      rule: Host(`learn.hcmute-dsc.io.vn`)
      entryPoints: [websecure]
      service: learning-hub
      tls:
        certResolver: letsencrypt
  services:
    learning-hub:
      loadBalancer:
        servers:
          - url: http://127.0.0.1:3100
