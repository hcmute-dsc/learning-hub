# Production settings. Copy to /opt/learning-hub/.env on the VPS (chmod 600).
# Never commit the real file. Read by docker compose (variables) and by the API (env_file).

# --- database (the same password appears twice: here and inside DATABASE_URL)
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://hub:change-me@db:5432/learning_hub?schema=public

# --- api
NODE_ENV=production
API_PORT=4000
LOG_LEVEL=info
# Public address of the site (OAuth redirects and the Origin check)
WEB_ORIGIN=https://learn.hcmute-dsc.io.vn

# GitHub OAuth app for PRODUCTION (not the localhost one).
# Callback URL: https://learn.hcmute-dsc.io.vn/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: members of this GitHub org are approved too (empty = off)
GITHUB_ORG=
# First admin, granted on first sign-in
BOOTSTRAP_ADMIN_GITHUB_LOGIN=TienNHM

# --- content: published from the GitHub content repo
CONTENT_SOURCE=github
CONTENT_REPO=hcmute-dsc/learning-hub-content
CONTENT_BRANCH=main
# Optional read-only fine-grained token (higher GitHub rate limit)
CONTENT_GITHUB_TOKEN=

# --- compose only
# Port on 127.0.0.1 where the reverse proxy finds the web app
WEB_PORT=3100

# Version (commit SHA) of the images that run. The deploy workflow rewrites this line;
# change it by hand only to roll back (deploy/README.md).
# IMAGE_TAG=
