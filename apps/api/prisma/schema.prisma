// Learning Hub database — see learning-hub-docs/docs/product/DATABASE.md
// Conventions: snake_case tables/columns via @@map/@map, uuid keys generated by the app (v7),
// enum-like columns are text + CHECK constraints (added in SQL migrations), not Postgres enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id               String    @id @db.Uuid
  githubId         BigInt    @unique @map("github_id")
  githubLogin      String    @map("github_login")
  displayName      String    @map("display_name")
  /// stored lower-cased by the app (unique when present — partial index in SQL migration)
  email            String?
  avatarUrl        String?   @map("avatar_url")
  /// short text on the member profile, max 280 chars (CHECK in SQL migration)
  bio              String?
  /// system | light | dark — color scheme picked in /settings
  theme            String    @default("system")
  /// false hides badges and the streak on the dashboard and the profile (F12)
  showAchievements Boolean   @default(true) @map("show_achievements")
  /// true shows the member on the term leaderboard (E14, ADR-08). Off by default.
  leaderboardOptIn Boolean   @default(false) @map("leaderboard_opt_in")
  /// pending | active | suspended
  status           String    @default("pending")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  roles                  UserRole[]              @relation("UserRoles")
  grantedRoles           UserRole[]              @relation("RoleGrantedBy")
  sessions               Session[]
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  submissions            Submission[]
  hintUnlocks            HintUnlock[]
  reviews                Review[]
  reviewComments         ReviewComment[]
  menteeAssignments      MentorAssignment[]      @relation("Mentee")
  mentorAssignments      MentorAssignment[]      @relation("Mentor")
  decidedAssignments     MentorAssignment[]      @relation("AssignmentDecidedBy")
  auditLogs              AuditLog[]
  addedApprovedEmails    ApprovedEmail[]
  syncedVersions         ContentVersion[]        @relation("SyncedBy")
  publishedVersions      ContentVersion[]        @relation("PublishedBy")
  badges                 UserBadge[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  certificates           Certificate[]           @relation("CertificateOwner")
  revokedCertificates    Certificate[]           @relation("CertificateRevokedBy")

  @@index([githubLogin])
  @@map("users")
}

model Role {
  id          Int        @id @db.SmallInt
  code        String     @unique
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    Int      @map("role_id") @db.SmallInt
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user          User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id])
  grantedByUser User? @relation("RoleGrantedBy", fields: [grantedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Session id is a random token; only its sha256 hash is stored.
model Session {
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Club members' emails. A GitHub sign-in whose verified emails include one of these
/// becomes `active` automatically (decided 16/11/2026, SECURITY §1). Admin-only data.
model ApprovedEmail {
  /// stored lower-cased
  email     String   @id
  note      String?
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  addedByUser User? @relation(fields: [addedBy], references: [id], onDelete: SetNull)

  @@map("approved_emails")
}

// ---------------------------------------------------------------- content (synced from Git)

model ContentVersion {
  id           String    @id @db.Uuid
  sourceRepo   String    @map("source_repo")
  commitSha    String    @map("commit_sha") @db.Char(40)
  /// draft | published | superseded | rejected
  status       String    @default("draft")
  summary      Json      @default("{}")
  /// registry only (ADR-10): { "<track slug>": { "repo": "owner/name", "commitSha": "…" } }
  trackSources Json?     @map("track_sources")
  syncedBy     String?   @map("synced_by") @db.Uuid
  publishedBy  String?   @map("published_by") @db.Uuid
  publishedAt  DateTime? @map("published_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  syncedByUser    User?        @relation("SyncedBy", fields: [syncedBy], references: [id])
  publishedByUser User?        @relation("PublishedBy", fields: [publishedBy], references: [id])
  tracks          Track[]
  modules         Module[]
  lessons         Lesson[]
  exercises       Exercise[]
  submissions     Submission[]

  @@unique([sourceRepo, commitSha])
  @@map("content_versions")
}

model Track {
  id               String   @id @db.Uuid
  slug             String   @unique
  title            String
  summary          String?
  /// beginner | intermediate | advanced
  level            String
  language         String   @default("vi")
  estHours         Int?     @map("est_hours") @db.SmallInt
  position         Int      @default(0)
  tags             String[] @default([])
  /// owner/repo of the track's starter template (one per track, has a folder per code exercise)
  starterRepo      String?  @map("starter_repo")
  /// docs/setup.md of the track ("Cài đặt" page), null when the track has none
  setupMd          String?  @map("setup_md")
  /// docs/resources.md of the track ("Tài liệu thêm" page), null when the track has none
  resourcesMd      String?  @map("resources_md")
  /// active | archived
  status           String   @default("active")
  contentVersionId String   @map("content_version_id") @db.Uuid
  sourcePath       String   @map("source_path")
  contentHash      String   @map("content_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contentVersion    ContentVersion     @relation(fields: [contentVersionId], references: [id])
  modules           Module[]
  enrollments       Enrollment[]
  mentorAssignments MentorAssignment[]
  certificates      Certificate[]

  @@index([status, position])
  @@map("tracks")
}

model Module {
  id               String   @id @db.Uuid
  trackId          String   @map("track_id") @db.Uuid
  slug             String
  title            String
  summary          String?
  position         Int
  status           String   @default("active")
  contentVersionId String   @map("content_version_id") @db.Uuid
  sourcePath       String   @map("source_path")
  contentHash      String   @map("content_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  track          Track          @relation(fields: [trackId], references: [id], onDelete: Restrict)
  contentVersion ContentVersion @relation(fields: [contentVersionId], references: [id])
  lessons        Lesson[]
  exercises      Exercise[]

  @@unique([trackId, slug])
  @@index([trackId, position])
  @@map("modules")
}

model Lesson {
  id               String   @id @db.Uuid
  moduleId         String   @map("module_id") @db.Uuid
  slug             String
  title            String
  bodyMd           String   @map("body_md")
  estMinutes       Int?     @map("est_minutes") @db.SmallInt
  position         Int
  status           String   @default("active")
  contentVersionId String   @map("content_version_id") @db.Uuid
  sourcePath       String   @map("source_path")
  contentHash      String   @map("content_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  contentVersion ContentVersion   @relation(fields: [contentVersionId], references: [id])
  exercises      Exercise[]
  progress       LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lessons")
}

model Exercise {
  id               String   @id @db.Uuid
  moduleId         String   @map("module_id") @db.Uuid
  lessonId         String?  @map("lesson_id") @db.Uuid
  slug             String
  title            String
  /// code | quiz | project | self_check
  type             String
  /// easy | medium | hard
  difficulty       String
  statementMd      String   @map("statement_md")
  spec             Json     @default("{}")
  /// [{ position, cost, bodyMd }] from hints/NN.md (CONTENT-SPECIFICATION §3.7). Members only get opened ones.
  hints            Json     @default("[]")
  /// Reference solution from the private checker repo (§3.8). Members only get it once they complete the exercise.
  solutionMd       String?  @map("solution_md")
  /// mentor-notes.md (CONTENT-SPECIFICATION §3.10). Only the mentor review page returns it.
  mentorNotesMd    String?  @map("mentor_notes_md")
  requiresReview   Boolean  @default(false) @map("requires_review")
  position         Int
  status           String   @default("active")
  contentVersionId String   @map("content_version_id") @db.Uuid
  sourcePath       String   @map("source_path")
  contentHash      String   @map("content_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  module         Module                 @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  lesson         Lesson?                @relation(fields: [lessonId], references: [id])
  contentVersion ContentVersion         @relation(fields: [contentVersionId], references: [id])
  prerequisites  ExercisePrerequisite[] @relation("Dependent")
  requiredBy     ExercisePrerequisite[] @relation("Required")
  submissions    Submission[]
  hintUnlocks    HintUnlock[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("exercises")
}

model ExercisePrerequisite {
  exerciseId         String @map("exercise_id") @db.Uuid
  requiredExerciseId String @map("required_exercise_id") @db.Uuid

  exercise         Exercise @relation("Dependent", fields: [exerciseId], references: [id], onDelete: Cascade)
  requiredExercise Exercise @relation("Required", fields: [requiredExerciseId], references: [id])

  @@id([exerciseId, requiredExerciseId])
  @@map("exercise_prerequisites")
}

// ---------------------------------------------------------------- learning

model Enrollment {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  trackId     String    @map("track_id") @db.Uuid
  /// active | completed | dropped
  status      String    @default("active")
  cohort      String?
  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id])
  track Track @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([userId, trackId])
  @@index([trackId, status])
  @@index([userId, status])
  @@map("enrollments")
}

model LessonProgress {
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  /// in_progress | completed
  status      String
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@id([userId, lessonId])
  @@index([userId, status])
  @@map("lesson_progress")
}

/// Badges a member earned (F12). The list of badges and their rules live in code
/// (packages/shared achievements.ts, learning/badges.ts); the key makes awarding idempotent.
model UserBadge {
  userId    String   @map("user_id") @db.Uuid
  /// a BadgeCode such as first_lesson; never renamed
  badge     String
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badge])
  @@map("user_badges")
}

/// Track completion certificate (PRD F19, learning-hub#47). Issued once per (user, track)
/// when the enrollment is first stored as completed. Name, track and content commit are
/// copied in, so the certificate keeps saying what was true on the day it was issued.
model Certificate {
  id            String    @id @db.Uuid
  /// 24 chars of base32 (CHECK in SQL migration), the unguessable part of /certificates/:code
  code          String    @unique
  userId        String    @map("user_id") @db.Uuid
  trackId       String    @map("track_id") @db.Uuid
  recipientName String    @map("recipient_name")
  trackSlug     String    @map("track_slug")
  trackTitle    String    @map("track_title")
  contentRepo   String    @map("content_repo")
  commitSha     String    @map("commit_sha") @db.Char(40)
  completedAt   DateTime  @map("completed_at") @db.Timestamptz
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  /// hidden from the member's profile; the public link keeps working
  hidden        Boolean   @default(false)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy     String?   @map("revoked_by") @db.Uuid
  revokeReason  String?   @map("revoke_reason")

  user          User  @relation("CertificateOwner", fields: [userId], references: [id])
  track         Track @relation(fields: [trackId], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("CertificateRevokedBy", fields: [revokedBy], references: [id])

  @@unique([userId, trackId])
  @@index([issuedAt(sort: Desc)])
  @@map("certificates")
}

model Submission {
  id               String   @id @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  exerciseId       String   @map("exercise_id") @db.Uuid
  contentVersionId String   @map("content_version_id") @db.Uuid
  attempt          Int
  /// github_pr | github_commit | quiz_answers | self_check | link
  sourceType       String   @map("source_type")
  repoFullName     String?  @map("repo_full_name")
  prNumber         Int?     @map("pr_number")
  headSha          String?  @map("head_sha") @db.Char(40)
  sourceUrl        String?  @map("source_url")
  answers          Json?
  note             String?
  status           String   @default("submitted")
  idempotencyKey   String?  @map("idempotency_key")
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user           User           @relation(fields: [userId], references: [id])
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  contentVersion ContentVersion @relation(fields: [contentVersionId], references: [id])
  testRuns       TestRun[]
  reviews        Review[]

  @@unique([userId, exerciseId, attempt])
  @@index([userId, submittedAt(sort: Desc)])
  @@index([repoFullName, headSha])
  @@map("submissions")
}

/// Who opened which hint (PRD F11). Counted in statistics; it never lowers a score.
model HintUnlock {
  userId     String   @map("user_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  /// 1-based, the NN of hints/NN.md
  position   Int
  openedAt   DateTime @default(now()) @map("opened_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([userId, exerciseId, position])
  @@index([exerciseId])
  @@map("hint_unlocks")
}

model TestRun {
  id            String    @id @db.Uuid
  submissionId  String    @map("submission_id") @db.Uuid
  /// github_checker | internal_quiz
  provider      String
  externalRunId BigInt?   @map("external_run_id")
  /// queued | running | passed | failed | errored
  status        String    @default("queued")
  summary       Json      @default("{}")
  runUrl        String?   @map("run_url")
  startedAt     DateTime? @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalRunId])
  @@index([submissionId, createdAt(sort: Desc)])
  @@map("test_runs")
}

// ---------------------------------------------------------------- mentoring

model Review {
  id           String    @id @db.Uuid
  submissionId String    @map("submission_id") @db.Uuid
  reviewerId   String    @map("reviewer_id") @db.Uuid
  /// in_progress | approved | changes_requested
  status       String    @default("in_progress")
  summaryMd    String?   @map("summary_md")
  /// [{ criterion, weight, score }] of a finished review (CHECK: JSON array, SQL migration)
  rubricScores Json?     @map("rubric_scores")
  /// completion time; NULL exactly while in_progress (CHECK in SQL migration)
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  submission Submission      @relation(fields: [submissionId], references: [id])
  reviewer   User            @relation(fields: [reviewerId], references: [id])
  comments   ReviewComment[]

  @@index([submissionId])
  @@index([reviewerId, status], map: "reviews_reviewer_idx")
  @@map("reviews")
}

model ReviewComment {
  id         String    @id @db.Uuid
  reviewId   String    @map("review_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  filePath   String?   @map("file_path")
  lineStart  Int?      @map("line_start")
  lineEnd    Int?      @map("line_end")
  bodyMd     String    @map("body_md")
  parentId   String?   @map("parent_id") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  review  Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id])
  parent  ReviewComment?  @relation("Thread", fields: [parentId], references: [id])
  replies ReviewComment[] @relation("Thread")

  @@index([reviewId])
  @@map("review_comments")
}

model MentorAssignment {
  id          String    @id @db.Uuid
  menteeId    String    @map("mentee_id") @db.Uuid
  mentorId    String?   @map("mentor_id") @db.Uuid
  trackId     String?   @map("track_id") @db.Uuid
  /// requested | active | declined | ended
  status      String    @default("requested")
  requestNote String?   @map("request_note")
  decidedBy   String?   @map("decided_by") @db.Uuid
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  mentee        User   @relation("Mentee", fields: [menteeId], references: [id])
  mentor        User?  @relation("Mentor", fields: [mentorId], references: [id])
  decidedByUser User?  @relation("AssignmentDecidedBy", fields: [decidedBy], references: [id])
  track         Track? @relation(fields: [trackId], references: [id])

  @@index([mentorId, status])
  @@map("mentor_assignments")
}

// ---------------------------------------------------------------- operations

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model WebhookDelivery {
  deliveryId  String    @id @map("delivery_id")
  event       String
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  @@map("webhook_deliveries")
}

model OutboxEvent {
  id            BigInt   @id @default(autoincrement())
  type          String
  payload       Json
  /// pending | sent | failed
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------- notifications (P2, F13)

/// One row per recipient for the in-app bell. Written by the outbox worker, never by a request.
model Notification {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// review_completed | review_requested | track_published (CHECK in SQL migration)
  type          String
  /// { title, body?, link } — text is built when the row is written, so the bell needs no joins
  payload       Json
  /// the outbox event that produced it; with userId it makes a retried fan-out a no-op
  sourceEventId BigInt?   @map("source_event_id")
  readAt        DateTime? @map("read_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, userId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Email digest choice per member. No row = digest off (the default).
model NotificationPreference {
  userId           String    @id @map("user_id") @db.Uuid
  emailDigest      Boolean   @default(false) @map("email_digest")
  /// random secret in the digest's unsubscribe link; works without signing in
  unsubscribeToken String    @unique @map("unsubscribe_token")
  lastDigestAt     DateTime? @map("last_digest_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
